{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "show-sidekick://artifacts/asset-manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "type": "array",
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "show-sidekick://artifacts/asset",
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "scene_ref": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "seed": {
            "type": "integer"
          },
          "prompt": {
            "type": "string"
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "attribution": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "show-sidekick://artifacts/asset-attribution",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source_url": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "source_domain": {
                "type": "string"
              },
              "license": {
                "type": "string"
              }
            },
            "required": [
              "source_url"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "path"
        ]
      }
    }
  },
  "required": [
    "assets"
  ]
}
